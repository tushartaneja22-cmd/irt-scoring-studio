engine/_acache.npz
# local-only xCalibre report readers (parse .rtf exports kept outside the repo)
engine/xcal_report.py
engine/_read_xcal_rtf.py

# Raw student-response data and reference values are NOT committed to this
# public repo. The app is upload-driven — provide these at runtime instead.
# Covers every export shape: Mock Test, Diagnostic Test, etc.
Digital_SAT_*.csv
A, B, C Values.xlsx
# per-mock ID-keyed reference JSON (a/b/c ground truth)
[0-9][0-9][0-9].txt
# generated per-mock a/b/c exports (may embed reference values)
mock_*_abc*.csv
# generated scaled-score exports and lookup tables (carry student names/emails)
mock_*scaled*.csv
mock_*_final_*.csv
mock_*_final_*.xlsx
mock_*_correct_to_scaled*.csv
mock_*_vs_xcalibre.*
mock126_scores.csv
# generated workbooks from any source form — the Scaled scores sheet carries
# student names, so match on the output shape rather than the `mock_` prefix
diagnostic_*.csv
diagnostic_*.xlsx
*_irt_scaled_*.csv
*_irt_scaled_*.xlsx
# scored-session exports pulled back from the live API (names + emails)
mock126_scaled.py
*Scores*.csv
*Scores.rtf
Mock [0-9]*.csv
# copy of the live Django scoring endpoint, kept locally for reference only
irt.py

